# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Audio outputs & generated media (ignore large generated MP3s)
outputs/*
!outputs/.gitkeep

# Custom voice recordings (keep directory structure, ignore personal voice files)
voices/*
!voices/.gitkeep
!voices/README.md

# Temporary audio and processing files
temp_*
*.tmp

# Gradio / Flagged
flagged/
.gradio/

# Model & TTS caches
.cache/
models/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editor & IDE directories
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment variables
.env
.env.local
.env.*.local

